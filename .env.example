# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app's Webhooks section (URL: <PUBLIC_BASE_URL>/api/paypal/webhook).
# Optional: without it, webhooks are rejected and everything else still works.
PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Meta Model API (Muse Spark). Leave empty to run the AI in demo mode.
META_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3

# Public URL of this app (used for PayPal return links and QR codes)
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Max value of a single order an AI agent may start (buyer still approves on PayPal)
AGENT_MAX_ORDER_USD=250
# Haggling: default private floor as a share of list price, max rounds, deal lifetime (minutes)
# DEFAULT_FLOOR_RATIO=0.85
# HAGGLE_MAX_ROUNDS=4
# DEAL_TTL_MIN=30
